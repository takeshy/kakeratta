#!/bin/bash
set -euo pipefail

exec > >(tee -a /var/log/kakeratta-startup.log) 2>&1

DATA_DEVICE=/dev/disk/by-id/google-kakeratta-data
DATA_MOUNT=/mnt/disks/kakeratta
mkdir -p "$DATA_MOUNT"

if ! blkid "$DATA_DEVICE" >/dev/null 2>&1; then
  mkfs.ext4 -F "$DATA_DEVICE"
fi
if ! mountpoint -q "$DATA_MOUNT"; then
  mount -o discard,defaults "$DATA_DEVICE" "$DATA_MOUNT"
fi
mkdir -p "$DATA_MOUNT/app" "$DATA_MOUNT/caddy/data" "$DATA_MOUNT/caddy/config" "$DATA_MOUNT/docker-config"
chown -R 65532:65532 "$DATA_MOUNT/app"
export DOCKER_CONFIG="$DATA_MOUNT/docker-config"

iptables -C INPUT -p tcp --dport 80 -j ACCEPT 2>/dev/null || iptables -I INPUT -p tcp --dport 80 -j ACCEPT
iptables -C INPUT -p tcp --dport 443 -j ACCEPT 2>/dev/null || iptables -I INPUT -p tcp --dport 443 -j ACCEPT

METADATA=http://metadata.google.internal/computeMetadata/v1
METADATA_HEADER='Metadata-Flavor: Google'
OAUTH_JSON=$(curl -fsS -H "$METADATA_HEADER" "$METADATA/instance/service-accounts/default/token")
OAUTH_TOKEN=$(printf '%s' "$OAUTH_JSON" | sed -n 's/.*"access_token":"\([^"]*\)".*/\1/p')
REGISTRY=$(printf '%s' '${image}' | cut -d/ -f1)
printf '%s' "$OAUTH_TOKEN" | docker login -u oauth2accesstoken --password-stdin "https://$REGISTRY"

SECRET_JSON=$(curl -fsS -H "Authorization: Bearer $OAUTH_TOKEN" \
  "https://secretmanager.googleapis.com/v1/projects/${project_id}/secrets/${secret_id}/versions/latest:access")
SECRET_DATA=$(printf '%s' "$SECRET_JSON" | sed -n 's/.*"data"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
KAKERATTA_TOKEN=$(printf '%s' "$SECRET_DATA" | tr '_-' '/+' | base64 -d)
test -n "$KAKERATTA_TOKEN"

until docker pull "${image}"; do
  sleep 10
done

docker rm -f kakeratta caddy 2>/dev/null || true
docker run -d --name kakeratta --restart unless-stopped --network host \
  -e KAKERATTA_ADDR=127.0.0.1:8787 \
  -e KAKERATTA_HOME=/data \
  -e KAKERATTA_TOKEN="$KAKERATTA_TOKEN" \
  -v "$DATA_MOUNT/app:/data" \
  "${image}"

cat > "$DATA_MOUNT/Caddyfile" <<'CADDYFILE'
${domain} {
  encode zstd gzip
  reverse_proxy 127.0.0.1:8787
}
CADDYFILE

docker run -d --name caddy --restart unless-stopped --network host \
  -v "$DATA_MOUNT/Caddyfile:/etc/caddy/Caddyfile:ro" \
  -v "$DATA_MOUNT/caddy/data:/data" \
  -v "$DATA_MOUNT/caddy/config:/config" \
  caddy:2-alpine
